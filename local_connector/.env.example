VIRGILIO_LOCAL_DATA_DIR=.local_data
VIRGILIO_MAX_ATTACHMENT_BYTES=26214400
VIRGILIO_SCANNER=auto
VIRGILIO_CONNECTOR_ID=local-readonly-probe

# Multi-account v1.1 example. Keep real values only in .env, never in Git.
# Two generic slots are shown below; mirror the same aliases in accounts.local.yaml.
VIRGILIO_IMAP_ACCOUNT_1_USERNAME=
VIRGILIO_IMAP_ACCOUNT_1_PASSWORD=
VIRGILIO_IMAP_ACCOUNT_1_ALIAS=account_1
VIRGILIO_IMAP_ACCOUNT_2_USERNAME=
VIRGILIO_IMAP_ACCOUNT_2_PASSWORD=
VIRGILIO_IMAP_ACCOUNT_2_ALIAS=account_2

# Limbo Drive: un solo folder cloud e un solo sync locale della stessa cartella.
VIRGILIO_LIMBO_ID=
VIRGILIO_LIMBO_LOCAL_SYNC_DIR=
VIRGILIO_LOCAL_DRIVE_STAGING_ENABLED=false

# Bridge Caronte e setup locale.
VIRGILIO_CARONTE_DRY_RUN_URL=
VIRGILIO_CARONTE_TIMEOUT_SECONDS=15
VIRGILIO_CARONTE_DRIVE_VERIFY_URL=
VIRGILIO_CARONTE_INTAKE_TEST_URL=
VIRGILIO_CARONTE_INTAKE_URL=
VIRGILIO_TOKEN=

# Bucoliche usa un solo workbook Google con i tab canonici Eventi/Stato/Conflitti.
VIRGILIO_BUCOLICHE_SPREADSHEET_ID=
VIRGILIO_EMPIREO_ID=
VIRGILIO_ADAMO_ID=
VIRGILIO_INBOX_SPREADSHEET_ID=
VIRGILIO_INBOX_SHEET_NAME=Virgilio_Inbox
VIRGILIO_INTAKE_TEST_SPREADSHEET_ID=
VIRGILIO_INTAKE_TEST_SHEET_NAME=Staging_Local_Test
VIRGILIO_GOOGLE_SERVICE_ACCOUNT_JSON=
VIRGILIO_GOOGLE_OAUTH_CLIENT_SECRETS_PATH=.local_data/google_oauth_client_secret.json
VIRGILIO_GOOGLE_OAUTH_TOKEN_PATH=.local_data/google_token.json
